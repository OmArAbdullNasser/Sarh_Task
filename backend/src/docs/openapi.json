          },
          {
            "$ref": "#/components/parameters/AppHeader"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sarh_session",
        "description": "Set automatically by POST /api/auth/login. Use same-origin Swagger UI; do not manually paste this cookie."
      }
    },
    "parameters": {
      "AppHeader": {
        "in": "header",
        "name": "X-SARH-Request",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ],
          "default": "1"
        },
        "description": "CSRF application header; Swagger UI adds it automatically."
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "507f1f77bcf86cd799439011"
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "agent"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "name",
          "email",
          "role",
          "active",
          "mustChangePassword"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/Id"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Integer halalas: 12550 = SAR 125.50.",
            "example": 12550
          }
        },
        "required": [
          "_id",
          "sku",
          "name",
          "unitPriceMinor"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "productId": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Integer halalas: 12550 = SAR 125.50.",
            "example": 12550
          }
        },
        "required": [
          "productId",
          "name",
          "quantity",
          "unitPriceMinor"
        ]
      },
      "SubmissionItem": {
        "type": "object",
        "properties": {
          "productId": {
            "$ref": "#/components/schemas/Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "example": 2
          },
          "expectedUnitPriceMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Integer halalas: 12550 = SAR 125.50.",
            "example": 12550
          }
        },
        "required": [
          "productId",
          "quantity",
          "expectedUnitPriceMinor"
        ],
        "additionalProperties": false
      },
      "OrderSubmission": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Omar Hassan"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "omar@example.com"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmissionItem"
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "customerName",
          "customerEmail",
          "items"
        ],
        "additionalProperties": false,
        "description": "1–5 distinct product lines. Prices are checked against the catalog, totals calculated by the server. No client total is accepted."
      },
      "Order": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/Id"
          },
          "createdBy": {
            "$ref": "#/components/schemas/Id"
          },
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "cancelled"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 1,
            "description": "Total in halalas."
          },
          "currency": {
            "type": "string",
            "enum": [
              "SAR"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "_id",
          "createdBy",
          "customerName",
          "customerEmail",
          "status",
          "items",
          "totalMinor",
          "currency",
          "createdAt",
          "deletedAt"
        ]
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/Id"
          },
          "operationKey": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "committed"
            ]
          },
          "submission": {
            "$ref": "#/components/schemas/OrderSubmission"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "_id",
          "operationKey",
          "state"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "ChangePasswordInput": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "additionalProperties": false
      },
      "CreateAgentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "New Agent"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "new.agent@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "example": "ChangeMe2026!"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "PrepareAttemptInput": {
        "type": "object",
        "properties": {
          "previousAttemptId": {
            "$ref": "#/components/schemas/Id"
          }
        },
        "additionalProperties": false
      },
      "CreateOrderInput": {
        "type": "object",
        "properties": {
          "attemptId": {
            "$ref": "#/components/schemas/Id"
          },
          "order": {
            "$ref": "#/components/schemas/OrderSubmission"
          }
        },
        "required": [
          "attemptId",
          "order"
        ],
        "additionalProperties": false
      },
      "CreateOrderResult": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "order",
          "replayed"
        ]
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "data",
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "data",
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid input, malformed JSON, unavailable product, or wrong current password.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error401": {
        "description": "Missing, invalid, expired, revoked session, inactive user, or invalid credentials.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error403": {
        "description": "Admin access required, first password change required, or CSRF/origin rejected.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "Resource or owned attempt not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "Conflict: changed price, reused key with different data, unresolved attempt, or duplicate email.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error415": {
        "description": "Request body must use application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error429": {
        "description": "Too many authentication attempts. Retry after the indicated limit reset.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Database connection is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error500": {
        "description": "Unexpected server or database error. Check the attempt status before retrying an order.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
