    "/api/orders/attempts": {
      "post": {
        "tags": [
          "Order attempts"
        ],
        "summary": "3. Prepare or resume an order attempt",
        "operationId": "post__api_orders_attempts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attempt": {
                      "$ref": "#/components/schemas/Attempt"
                    }
                  },
                  "required": [
                    "attempt"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "description": "Start with {}. Save attempt._id and operationKey. Parallel calls share one active attempt per employee. After a confirmed success, pass its previousAttemptId to prepare the next form. Passing an unresolved current ID returns 409. A delayed acknowledgment cannot replace a newer attempt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareAttemptInput"
              },
              "examples": {
                "resume": {
                  "summary": "Prepare/resume current attempt",
                  "value": {}
                },
                "next": {
                  "summary": "Acknowledge a successful attempt and prepare next",
                  "value": {
                    "previousAttemptId": "507f1f77bcf86cd799439011"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/AppHeader"
          }
        ]
      }
    },
    "/api/orders/attempts/current": {
      "get": {
        "tags": [
          "Order attempts"
        ],
        "summary": "Recover after a timeout or refresh",
        "operationId": "get__api_orders_attempts_current",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attempt": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Attempt"
                        }
                      ],
                      "nullable": true
                    }
                  },
                  "required": [
                    "attempt"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "description": "null means no active attempt. draft can restore submitted fields for correction; submitted should be retried with its exact saved payload/key; committed means the order already exists. No permanent browser draft is required."
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Search, filter, sort and paginate orders",
        "operationId": "get__api_orders",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "description": "Only committed, non-deleted orders. Exact total included; _id breaks sort ties. Unknown query parameters are rejected. Dates are UTC, frontend display is Asia/Riyadh.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 254
            },
            "description": "Beginning of full customer name OR email, case normalized. Does not match arbitrary middle text."
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "completed",
                "cancelled"
              ]
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "totalMinor"
              ],
              "default": "createdAt"
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "description": ""
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "4. Create an order once (safe to retry)",
        "operationId": "post__api_orders",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "200": {
            "description": "Existing order replayed (no second order)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResult"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "description": "Copy attemptId and operationKey from step 3; copy productId and price from step 2. Do not send total, price overrides, user IDs, currency, or status. First commit returns 201; exact replays return 200 with the original order. Different content on a committed key returns IDEMPOTENCY_CONFLICT. PRICE_CHANGED requires reviewing returned prices and correcting the draft. A deleted order is replayed with deletedAt set, never recreated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderInput"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "operationKey returned by prepare. Keep unchanged for every retry of this attempt."
          },
          {
            "$ref": "#/components/parameters/AppHeader"
          }
        ]
      }
    },
