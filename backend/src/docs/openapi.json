          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "1. Sign in (start here)",
        "operationId": "post__api_auth_login",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "sarh_session; HttpOnly; SameSite=Strict; Max-Age=28800; Secure in production. Managed by the browser.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        },
        "description": "Use Try it out, select a seeded example, then Execute. The same-origin browser stores the HttpOnly cookie automatically; no Authorize/paste-token step is needed. Agent and Admin share the documented development password. Login rate limit: 30 attempts per 15 minutes per IP.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              },
              "examples": {
                "admin": {
                  "summary": "Seeded Admin",
                  "value": {
                    "email": "admin@sarh.local",
                    "password": "SarhDemo2026!"
                  }
                },
                "agent": {
                  "summary": "Seeded Agent",
                  "value": {
                    "email": "agent@sarh.local",
                    "password": "SarhDemo2026!"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/AppHeader"
          }
        ]
      }
    },
